# Puerta única de la web de facturas.
# - https://localhost      → web/ + reenvío de /webhook/* a n8n (mismo origen: sin CORS ni contenido mixto)
# Ambos escuchan SOLO en 127.0.0.1 (no quedan abiertos en tu wifi/LAN).
# - http://:8080 (cualquier host) → lo mismo sin TLS; lo usa Tailscale Serve, que reenvía con su propio nombre de host
{
	admin localhost:2019
}

(sitio) {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	handle /webhook/* {
		reverse_proxy localhost:5678 {
			header_up Host localhost:5678
		}
	}
	handle {
		root * {$FACTURAS_WEB_DIR}
		file_server
	}
}

https://localhost {
	bind 127.0.0.1
	tls internal
	import sitio
}

http://:8080 {
	bind 127.0.0.1
	import sitio
}
