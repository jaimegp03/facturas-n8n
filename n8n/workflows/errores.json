      {
        "id": "4fb81acc-146c-47c0-92ed-4e473d86bdf4",
        "name": "Preparar registro",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          240,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Solo ids, nodo y mensaje (recortado). Nunca contenido de facturas.\nconst BASE_N8N = 'http://localhost:5678';\nconst e = $input.first().json || {};\nconst ex = e.execution || {};\nconst wf = e.workflow || {};\nconst err = ex.error || (e.trigger && e.trigger.error) || {};\nconst mensaje = String(err.message || 'Error sin mensaje').replace(/\\s+/g, ' ').trim().slice(0, 300);\nconst nodo = ex.lastNodeExecuted || (err.node && err.node.name) || null;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst registro = {\n  fecha: $now.setZone('Europe/Madrid').toISO(),\n  workflow: wf.name || wf.id || 'desconocido',\n  nodo,\n  mensaje,\n  ejecucion_id: ex.id !== undefined && ex.id !== null ? String(ex.id) : null,\n};\nconst enlace = wf.id && registro.ejecucion_id ? `${BASE_N8N}/workflow/${encodeURIComponent(wf.id)}/executions/${encodeURIComponent(registro.ejecucion_id)}` : null;\nconst asunto = `[FACT] Error en ${registro.workflow}`;\nconst html = [\n  `<p><b>Error en ${esc(registro.workflow)}</b></p>`,\n  '<ul>',\n  `<li>Workflow: ${esc(registro.workflow)}${wf.id ? ' (' + esc(wf.id) + ')' : ''}</li>`,\n  `<li>Nodo: ${esc(nodo || '-')}</li>`,\n  `<li>Mensaje: ${esc(mensaje)}</li>`,\n  `<li>Ejecución: ${esc(registro.ejecucion_id || '-')}</li>`,\n  `<li>Fecha: ${esc(registro.fecha)}</li>`,\n  '</ul>',\n  enlace ? `<p><a href=\"${esc(enlace)}\">Abrir la ejecución en n8n</a> (${esc(enlace)})</p>` : '<p>Sin enlace: la ejecución no se guardó.</p>',\n].join('\\n');\nreturn [{ json: { registro, correo: { asunto, html } } }];\n"
        }
      },
