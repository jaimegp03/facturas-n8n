          440,
          0
        ],
        "parameters": {
          "jsCode": "// Mismo criterio que normalizarMetodoPago (bloque COMÚN Ingesta/API): primera letra en mayúscula,\n// el resto como venga. Solo devuelve las filas que cambian (id + metodo_pago).\nconst txtOrNull = (s) => (typeof s === 'string' && s.trim() ? s.trim() : null);\nconst normalizarMetodoPago = (s) => { const t = txtOrNull(s); return t ? t.charAt(0).toLocaleUpperCase('es-ES') + t.slice(1) : null; };\nconst out = [];\nfor (const f of $input.all().map((i) => i.json)) {\n  if (!f || f.id === undefined || f.id === null || f.metodo_pago === null || f.metodo_pago === undefined) continue;\n  const nuevo = normalizarMetodoPago(f.metodo_pago);\n  if (nuevo !== f.metodo_pago) out.push({ json: { id: f.id, metodo_pago: nuevo } });\n}\nreturn out;"
        }
      },
