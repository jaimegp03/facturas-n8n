# Copia este archivo a .env (no lo subas al repositorio).
# Las credenciales reales (Gemini, token de la API, Gmail) se guardan en el
# gestor de credenciales de n8n, no aquí.

# URL base de los webhooks de n8n
N8N_BASE_URL=http://localhost:5678
# Token que la web y los scripts de prueba envían en la cabecera X-API-Key
# (debe coincidir con la credencial "FACT API Key" de n8n)
FACT_API_KEY=
# Token del MCP integrado de n8n (Settings → Instance-level MCP → Access Token).
# Claude Code lo lee como variable de entorno de Windows: Authorization: Bearer ${N8N_MCP_TOKEN}
N8N_MCP_TOKEN=
# Clave de la API REST de n8n (Settings → n8n API), solo si no hay MCP
N8N_API_KEY=
